{{ 'purelane-categories.css' | asset_url | stylesheet_tag }}

<section class="sec" id="{{ section.settings.section_id | default: 'categories' }}" data-scene="{{ section.settings.scene_number | default: 4 }}">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        <a class="glass cat rv" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span class="ph">
            <span class="pimg {{ block.settings.icon_class }}" role="img" aria-label="{{ block.settings.title }}"></span>
          </span>
          <span class="txt">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.desc }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "default": "categories"
    },
    {
      "type": "number",
      "id": "scene_number",
      "label": "Scene Number",
      "default": 4
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "icon_class",
          "label": "Icon Class",
          "info": "E.g., p-kitchen, p-toilet, p-laundry, p-tap",
          "default": "p-kitchen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Categories",
      "blocks": [
        { "type": "category", "settings": { "icon_class": "p-kitchen", "title": "Kitchen bundle", "desc": "Grease, dishes & more", "link": "#combos" } },
        { "type": "category", "settings": { "icon_class": "p-toilet", "title": "Bathroom bundle", "desc": "Deep clean & disinfect", "link": "#combos" } },
        { "type": "category", "settings": { "icon_class": "p-laundry", "title": "Laundry bundle", "desc": "Softer, fresher wash", "link": "#combos" } },
        { "type": "category", "settings": { "icon_class": "p-tap", "title": "Hard water bundle", "desc": "Melt away limescale", "link": "#combos" } }
      ]
    }
  ]
}
{% endschema %}
