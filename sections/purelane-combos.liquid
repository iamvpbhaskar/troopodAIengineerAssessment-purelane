{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

<section class="sec" id="{{ section.settings.section_id | default: 'combos' }}" data-scene="{{ section.settings.scene_number | default: 3 }}">
  <div class="wrap">
    
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="panel-head rv">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <i></i>
        </div>
        
        {%- if section.settings.lede != blank -%}
          <p class="lede" style="margin:14px auto 0">{{ section.settings.lede }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="comborail rv">
      {%- assign metaobject_combos = shop.metaobjects.combo.values -%}
      
      {%- if metaobject_combos != blank and metaobject_combos.size > 0 -%}
        {%- for combo in metaobject_combos -%}
          {%- render 'combo-card', combo: combo -%}
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- render 'combo-card', block: block -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback if no metaobjects and no blocks -->
        {%- for i in (1..4) -%}
          <article class="glass combo {% if i == 2 %}hero-combo{% endif %}">
            <div class="tray">
              <span class="save">You save ₹398</span>
              {% if i == 2 %}<span class="flag">Best value</span>{% endif %}
              <div class="stack">
                <span class="it">
                  {{ 'product-1' | placeholder_svg_tag: 'pimg placeholder' }}
                  <span>Product 1</span>
                </span>
                <span class="plus" aria-hidden="true">+</span>
                <span class="it">
                  {{ 'product-2' | placeholder_svg_tag: 'pimg placeholder' }}
                  <span>Product 2</span>
                </span>
              </div>
            </div>
            <div class="body">
              <h3>Sample Combo {{ i }}</h3>
              <div class="cnt">2 products</div>
              <p class="inc">Includes everything you need to start.</p>
              <div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div>
              <div class="fine">Inclusive of all taxes &middot; COD available</div>
              <a class="btn {% if i == 2 %}btn-primary{% else %}btn-ghost{% endif %}" href="#bundles">
                Shop bundle
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    
    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      Swipe for more combos
    </div>
    <p class="railnote">Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>

{% schema %}
{
  "name": "Combos",
  "tag": "section",
  "class": "shopify-section-combos",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "combos"
    },
    {
      "type": "number",
      "id": "scene_number",
      "label": "Background Scene Number",
      "default": 3
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen essentials" },
        { "type": "text", "id": "savings_label", "label": "Savings label", "default": "You save ₹398" },
        { "type": "text", "id": "flag_label", "label": "Flag label", "info": "E.g. Most popular" },
        { "type": "checkbox", "id": "is_hero", "label": "Highlight as Hero combo?", "default": false },
        { "type": "textarea", "id": "includes_text", "label": "Includes description" },
        { "type": "text", "id": "price", "label": "Combo price", "default": "₹499" },
        { "type": "text", "id": "compare_price", "label": "Compare at price", "default": "₹897" },
        { "type": "text", "id": "discount_pill", "label": "Discount pill text", "default": "Save ₹398" },
        { "type": "url", "id": "link", "label": "Bundle Link" },
        
        { "type": "header", "content": "Product 1" },
        { "type": "product", "id": "product_1", "label": "Product" },
        { "type": "text", "id": "product_1_label", "label": "Label" },
        
        { "type": "header", "content": "Product 2" },
        { "type": "product", "id": "product_2", "label": "Product" },
        { "type": "text", "id": "product_2_label", "label": "Label" },
        
        { "type": "header", "content": "Product 3" },
        { "type": "product", "id": "product_3", "label": "Product" },
        { "type": "text", "id": "product_3_label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combos",
      "blocks": [
        { "type": "combo", "settings": { "title": "Kitchen essentials", "savings_label": "You save ₹398" } },
        { "type": "combo", "settings": { "title": "Laundry care bundle", "savings_label": "You save ₹448" } },
        { "type": "combo", "settings": { "title": "Complete home bundle", "is_hero": true, "savings_label": "Biggest saving", "flag_label": "Best value" } }
      ]
    }
  ]
}
{% endschema %}
