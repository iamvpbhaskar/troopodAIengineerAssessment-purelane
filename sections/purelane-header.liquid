{{ 'purelane-header.css' | asset_url | stylesheet_tag }}

<header id="hdr">
  <div class="navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | default: 'Purelane' }} home">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name | default: 'Purelane' }}</span>
        <span class="n2">{{ section.settings.tagline | default: 'Clean, simply' }}</span>
      </span>
    </a>
    
    <nav class="nav" aria-label="Main">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- else -%}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.root_url }}#ingredients">Ingredients</a>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="{{ routes.root_url }}#how">How it works</a>
        <a href="/pages/contact">Contact</a>
      {%- endfor -%}
    </nav>
    
    <div class="navtools">
      <a href="{{ routes.search_url }}" class="ico hide-s" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="ico hide-s" aria-label="Account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg></a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="ico" id="cart-icon-bubble" aria-label="Cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        {%- if cart != empty -%}
          <span class="dot">{{ cart.item_count }}</span>
        {%- else -%}
          <span class="dot">0</span>
        {%- endif -%}
      </a>
      <button class="ico burger" aria-label="Menu" id="burger-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path class="l1" d="M4 8h16"/>
          <path class="l2" d="M4 16h16"/>
        </svg>
      </button>
    </div>
  </div>
  
  <div class="mob-menu glass" id="mob-menu">
    <nav class="mob-nav">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- else -%}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.root_url }}#ingredients">Ingredients</a>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="{{ routes.root_url }}#how">How it works</a>
        <a href="/pages/contact">Contact</a>
      {%- endfor -%}
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const burger = document.getElementById('burger-btn');
    const header = document.getElementById('hdr');
    const mobMenu = document.getElementById('mob-menu');

    burger.addEventListener('click', () => {
      header.classList.toggle('menu-open');
    });

    // Close menu when clicking a link inside it
    const mobLinks = mobMenu.querySelectorAll('a');
    mobLinks.forEach(link => {
      link.addEventListener('click', () => {
        header.classList.remove('menu-open');
      });
    });
  });
</script>

{% schema %}
{
  "name": "Purelane Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Purelane Header"
    }
  ]
}
{% endschema %}
