{{ 'purelane-how.css' | asset_url | stylesheet_tag }}

<section class="sec" id="{{ section.settings.section_id | default: 'how' }}" data-scene="{{ section.settings.scene_number | default: 2 }}">
  <div class="wrap">
    <div class="pillars">
      <article class="glass pillar rv">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
        </span>
        <h3 class="d3">{{ section.settings.pillar_1_heading }}</h3>
        <p class="body-s">{{ section.settings.pillar_1_text }}</p>
        {%- if section.settings.pillar_1_btn_text != blank -%}
          <a class="btn btn-ghost btn-sm" href="{{ section.settings.pillar_1_btn_link }}">{{ section.settings.pillar_1_btn_text }}</a>
        {%- endif -%}
      </article>
      <article class="glass pillar rv rv-d2">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
        </span>
        <h3 class="d3">{{ section.settings.pillar_2_heading }}</h3>
        <p class="body-s">{{ section.settings.pillar_2_text }}</p>
        {%- if section.settings.pillar_2_btn_text != blank -%}
          <a class="btn btn-ghost btn-sm" href="{{ section.settings.pillar_2_btn_link }}">{{ section.settings.pillar_2_btn_text }}</a>
        {%- endif -%}
      </article>
      <article class="glass pillar rv rv-d3">
        <span class="pi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
        </span>
        <h3 class="d3">{{ section.settings.pillar_3_heading }}</h3>
        <p class="body-s">{{ section.settings.pillar_3_text }}</p>
        {%- if section.settings.pillar_3_btn_text != blank -%}
          <a class="btn btn-ghost btn-sm" href="{{ section.settings.pillar_3_btn_link }}">{{ section.settings.pillar_3_btn_text }}</a>
        {%- endif -%}
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane How It Works",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "default": "how"
    },
    {
      "type": "number",
      "id": "scene_number",
      "label": "Scene Number",
      "default": 2
    },
    {
      "type": "header",
      "content": "Pillar 1"
    },
    {
      "type": "text",
      "id": "pillar_1_heading",
      "label": "Heading",
      "default": "Less scrubbing"
    },
    {
      "type": "textarea",
      "id": "pillar_1_text",
      "label": "Text",
      "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
    },
    {
      "type": "text",
      "id": "pillar_1_btn_text",
      "label": "Button Text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "pillar_1_btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Pillar 2"
    },
    {
      "type": "text",
      "id": "pillar_2_heading",
      "label": "Heading",
      "default": "Clean ingredients"
    },
    {
      "type": "textarea",
      "id": "pillar_2_text",
      "label": "Text",
      "default": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food."
    },
    {
      "type": "text",
      "id": "pillar_2_btn_text",
      "label": "Button Text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "pillar_2_btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Pillar 3"
    },
    {
      "type": "text",
      "id": "pillar_3_heading",
      "label": "Heading",
      "default": "Safe around everyone"
    },
    {
      "type": "textarea",
      "id": "pillar_3_text",
      "label": "Text",
      "default": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day."
    },
    {
      "type": "text",
      "id": "pillar_3_btn_text",
      "label": "Button Text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "pillar_3_btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Purelane How It Works"
    }
  ]
}
{% endschema %}
