{{ 'purelane-reviews.css' | asset_url | stylesheet_tag }}

<section class="sec revband" id="{{ section.settings.section_id | default: 'reviews' }}" data-scene="{{ section.settings.scene_number | default: 1 }}">
  <div class="wrap">
    <div class="revhead rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating_text }}</span>
      {%- endif -%}
      {%- if section.settings.homes_text != blank -%}
        <span class="agg">{{ section.settings.homes_text }}</span>
      {%- endif -%}
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5>{{ block.settings.title }}</h5>
            <p>{{ block.settings.content }}</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>{{ block.settings.author }}</b>
              {%- if block.settings.product_label != blank -%}
                <span>&middot; {{ block.settings.product_label }}</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Marquee",
  "tag": "section",
  "class": "shopify-section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "default": "reviews"
    },
    {
      "type": "number",
      "id": "scene_number",
      "label": "Background Scene Number",
      "default": 1
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "That's what they said"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Rating summary text",
      "default": "<p><b>4.8</b> from 8,000+ reviews</p>"
    },
    {
      "type": "richtext",
      "id": "homes_text",
      "label": "Homes text",
      "default": "<p>Loved by <b>12 lakh+</b> homes</p>"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Review content",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product label",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Marquee",
      "blocks": [
        { "type": "review", "settings": { "title": "Works like a charm", "content": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "author": "Anita", "product_label": "Laundry detergent" } },
        { "type": "review", "settings": { "title": "Best dishwash ever", "content": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "author": "Priya", "product_label": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Great product, great packaging", "content": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "author": "Sunita", "product_label": "Liquid handwash" } },
        { "type": "review", "settings": { "title": "Dog friendly", "content": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "author": "Rohit S.", "product_label": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "content": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "author": "Verified buyer", "product_label": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}
