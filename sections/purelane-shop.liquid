{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}

<section class="sec shop-grid" id="{{ section.settings.section_id | default: 'shop' }}" data-scene="{{ section.settings.scene_number | default: 3 }}">
  <div class="wrap">
    
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="panel-head rv">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <i></i>
        </div>
      </div>
    {%- endif -%}

    <div class="shelf">
      {%- assign products_to_show = section.settings.products_to_show -%}
      {%- assign shop_collection = section.settings.collection -%}
      {%- if shop_collection == blank or shop_collection.products.size == 0 -%}
        {%- assign shop_collection = collections['all'] -%}
      {%- endif -%}

      {%- if shop_collection != blank and shop_collection.products.size > 0 -%}
        {%- for product in shop_collection.products limit: products_to_show -%}
          {%- liquid
            assign anim_index = forloop.index0 | modulo: 4
            assign anim_class = ''
            if anim_index == 1
              assign anim_class = 'rv-d1'
            elsif anim_index == 2
              assign anim_class = 'rv-d2'
            elsif anim_index == 3
              assign anim_class = 'rv-d3'
            endif
          -%}
          {% render 'product-card', product: product, anim_class: anim_class %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          {%- liquid
            assign anim_index = forloop.index0 | modulo: 4
            assign anim_class = ''
            if anim_index == 1
              assign anim_class = 'rv-d1'
            elsif anim_index == 2
              assign anim_class = 'rv-d2'
            elsif anim_index == 3
              assign anim_class = 'rv-d3'
            endif
          -%}
          <article class="glass card rv {% if anim_class != '' %}{{ anim_class }}{% endif %}">
            <div class="shot">
              {{ 'product-' | append: i | placeholder_svg_tag: 'pimg placeholder' }}
            </div>
            <h4>Sample Product</h4>
            <div class="rate"><b>★ 4.8</b> · 100 reviews</div>
            <div class="pr">
              <strong>$20.00</strong>
            </div>
            <button class="btn btn-ghost btn-sm" disabled>Add to cart</button>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    
  </div>
</section>

{% schema %}
{
  "name": "Shop Grid",
  "tag": "section",
  "class": "shopify-section-shop-grid",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "shop"
    },
    {
      "type": "number",
      "id": "scene_number",
      "label": "Background Scene Number",
      "default": 3,
      "info": "Defines which background gradient applies (1-4)."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Shop Grid"
    }
  ]
}
{% endschema %}
