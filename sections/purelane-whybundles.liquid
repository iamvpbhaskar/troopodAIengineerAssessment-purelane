{{ 'purelane-whybundles.css' | asset_url | stylesheet_tag }}

<section class="sec" id="{{ section.settings.section_id | default: 'whybundles' }}" data-scene="{{ section.settings.scene_number | default: 4 }}">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      </div>
      <div class="wb">
        <div class="wb-i">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg></span>
          <h4>{{ section.settings.block_1_title }}</h4>
          <p>{{ section.settings.block_1_text }}</p>
        </div>
        <div class="wb-i">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3.4"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/></svg></span>
          <h4>{{ section.settings.block_2_title }}</h4>
          <p>{{ section.settings.block_2_text }}</p>
        </div>
        <div class="wb-i">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg></span>
          <h4>{{ section.settings.block_3_title }}</h4>
          <p>{{ section.settings.block_3_text }}</p>
        </div>
        <div class="wb-i">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 16.4V7.2h10.2v9.2"/><path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/><circle cx="6.6" cy="18" r="1.9"/><circle cx="16.6" cy="18" r="1.9"/></svg></span>
          <h4>{{ section.settings.block_4_title }}</h4>
          <p>{{ section.settings.block_4_text }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Why Bundles",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "default": "whybundles"
    },
    {
      "type": "number",
      "id": "scene_number",
      "label": "Scene Number",
      "default": 4
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    },
    {
      "type": "header",
      "content": "Block 1"
    },
    {
      "type": "text",
      "id": "block_1_title",
      "label": "Title",
      "default": "Save up to 45%"
    },
    {
      "type": "text",
      "id": "block_1_text",
      "label": "Text",
      "default": "Versus buying the same products separately"
    },
    {
      "type": "header",
      "content": "Block 2"
    },
    {
      "type": "text",
      "id": "block_2_title",
      "label": "Title",
      "default": "One flat price"
    },
    {
      "type": "text",
      "id": "block_2_text",
      "label": "Text",
      "default": "No calculators, no comparing carts"
    },
    {
      "type": "header",
      "content": "Block 3"
    },
    {
      "type": "text",
      "id": "block_3_title",
      "label": "Title",
      "default": "Curated by experts"
    },
    {
      "type": "text",
      "id": "block_3_text",
      "label": "Text",
      "default": "Products picked to work well together"
    },
    {
      "type": "header",
      "content": "Block 4"
    },
    {
      "type": "text",
      "id": "block_4_title",
      "label": "Title",
      "default": "Free shipping always"
    },
    {
      "type": "text",
      "id": "block_4_text",
      "label": "Text",
      "default": "Included on every bundle, all India"
    }
  ],
  "presets": [
    {
      "name": "Purelane Why Bundles"
    }
  ]
}
{% endschema %}
